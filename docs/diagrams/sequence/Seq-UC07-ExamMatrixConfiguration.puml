@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam maxMessageSize 110
title UC07 - Cấu hình đề và ma trận (thiết kế tích hợp dự kiến)
actor "Giảng viên" as gv
participant "Giao diện tạo/sửa đề" as ui
participant "FastAPI (Python)" as api
database "Kho dữ liệu" as db
note over ui, db
  FE hiện dựng payload/state, chưa gửi hoặc lưu cấu hình lên server.
  Endpoint là đề xuất từ API-CONTRACT; tạo/sửa và xuất bản là hai bước.
end note
gv -> ui : Nhập mã, tên, loại, môn, học kỳ, phòng, lịch, thời lượng, số lượt
gv -> ui : Chọn mã đề/xáo trộn, antiCheat, showScoreImmediately, allowReview
alt Theo ma trận
  gv -> ui : Chọn chương, số câu và tỷ lệ độ khó
  ui -> api : POST /exams/generate-matrix
  api -> db : Kiểm tra phạm vi môn và đủ câu theo ma trận
  api --> ui : Câu được chọn hoặc lỗi thiếu câu
else Thủ công
  ui -> api : GET /questions với bộ lọc môn/chương/loại/độ khó
  api --> ui : Câu hỏi thuộc phạm vi GV
  gv -> ui : Chọn và duyệt câu đưa vào đề
end
gv -> ui : Lưu nháp hoặc lưu và xuất bản
alt Tạo đề
  ui -> api : POST /exams
else Sửa đề
  ui -> api : PATCH /exams/{id}
end
api -> db : Kiểm tra quyền, trạng thái cho sửa, lịch và cấu hình
alt Không hợp lệ
  api --> ui : 403/409/422 và lỗi chi tiết
  ui --> gv : Giữ form và hiển thị lỗi
else Lưu hợp lệ
  api -> db : Lưu Exam, ExamMatrix và ExamQuestion
  api --> ui : examId và trạng thái nháp
  opt Yêu cầu xuất bản
    ui -> api : PATCH /exams/{id}/publish
    api -> db : Kiểm tra đủ câu/điểm, lịch, số lượt và cờ cấu hình
    alt Đủ điều kiện
      api -> db : Chốt snapshot/mã đề và trạng thái theo lịch server
      api --> ui : Xác nhận xuất bản
    else Không đủ điều kiện
      api --> ui : Lý do không xuất bản; nháp đã lưu được giữ
    end
  end
  ui --> gv : Thông báo đúng kết quả, tải lại danh sách
end
@enduml
