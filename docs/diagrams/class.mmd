---
title: EduTesting - Mô hình lớp nghiệp vụ (đề xuất cho Python/FastAPI)
---
%% Các lớp dưới đây là khái niệm miền nghiệp vụ, không phải React class component.
%% Dịch vụ/thuộc tính là đề xuất BE, chưa có ORM hoặc các lớp Python triển khai.
classDiagram
direction TB
class User {
  +str id
  +str identifier
  +str role
  +str status
}
class Subject {
  +str id
  +str code
  +str name
}
class Chapter {
  +str id
  +str name
  +int order
}
class TeachingAssignment
class QuestionBank
class Question {
  +str id
  +str type
  +str difficulty
  +list acceptedKeywords
  +bool isCaseSensitive
  +bool allowPartialKeywordScore
}
class Answer {
  +str id
  +str content
  +bool isCorrect
}
class AIGenerationRequest
class Semester {
  +str id
  +str label
}
class Exam {
  +str id
  +str examCode
  +str category
  +str status
  +datetime openAt
  +datetime closeAt
  +int durationMinutes
  +int maxAttempts
  +bool antiCheat
  +bool showScoreImmediately
  +bool allowReview
}
class ExamMatrix
class ExamQuestion {
  +int order
  +float maxScore
}
class ExamCode {
  +str testCode
  +list questionOrder
  +dict answerOrder
}
class ExamRoom {
  +str roomCode
  +int capacity
}
class ExamAssignment
class ExamAttempt {
  +str id
  +int attemptNumber
  +str status
  +str violationResolution
  +datetime startedAt
  +datetime expiresAt
  +datetime submittedAt
}
class AttemptQuestion {
  +int order
  +dict questionSnapshot
  +dict gradingSnapshot
}
class StudentAnswer {
  +str textAnswer
  +float gradedScore
  +str gradingStatus
  +str teacherComment
}
class SelectedAnswer
class ExamResult {
  +float rawScore
  +float score
  +bool scorePublished
  +datetime publishedAt
}
class ViolationLog {
  +str eventId
  +str type
  +datetime occurredAt
}
class ViolationReport {
  +str penaltyCode
  +str detail
  +datetime reportedAt
  +datetime resolvedAt
}
class ResultAccess {
  <<valueObject>>
  +bool canShowScore
  +bool canReview
  +bool canShowDetails
}
class AIQuestionService {
  <<service>>
  +generate_questions()
}
class ExamService {
  <<service>>
  +start_or_resume_attempt()
  +save_answers()
  +submit_once()
}
class GradingService {
  <<service>>
  +match_keywords()
  +save_manual_grades()
  +recalculate_result()
}
class MonitoringService {
  <<service>>
  +record_event_once()
  +suspend_attempt()
  +save_report()
}
class ResultAccessPolicy {
  <<service>>
  +evaluate_permissions()
}
